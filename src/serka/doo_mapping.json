{
	"doo_version": "0.3.3",
	"prefixes": {
		"dcat": "http://www.w3.org/ns/dcat#",
		"dcterms": "http://purl.org/dc/terms/",
		"doo": "https://digital.ceh.ac.uk/ontology/doo/",
		"fabio": "http://purl.org/spar/fabio/",
		"foaf": "http://xmlns.com/foaf/0.1/",
		"frapo": "http://purl.org/cerif/frapo/",
		"geo": "http://www.opengis.net/ont/geosparql#",
		"org": "http://www.w3.org/ns/org#",
		"pro": "http://purl.org/spar/pro/",
		"prov": "http://www.w3.org/ns/prov#",
		"rdfs": "http://www.w3.org/2000/01/rdf-schema#",
		"scoro": "http://purl.org/spar/scoro/",
		"serka": "urn:serka:",
		"skos": "http://www.w3.org/2004/02/skos/core#",
		"xsd": "http://www.w3.org/2001/XMLSchema#"
	},
	"terms": {
		"label": "rdfs:label",
		"title": "dcterms:title",
		"name": "foaf:name",
		"publication_date": {"@id": "dcterms:issued", "@type": "xsd:date"},
		"identifiers": "dcterms:identifier",
		"resource_type": "dcterms:type",
		"access_rights": "dcterms:accessRights",
		"licence": {"@id": "dcterms:license", "@type": "@id"},
		"temporal": "dcterms:temporal",
		"start_date": {"@id": "dcat:startDate", "@type": "xsd:date"},
		"end_date": {"@id": "dcat:endDate", "@type": "xsd:date"},
		"bbox": {"@id": "dcat:bbox", "@type": "geo:wktLiteral"},
		"citations": {"@id": "serka:citationCount", "@type": "xsd:integer"},
		"scheme": "skos:inScheme",
		"format": "dcterms:format",
		"bibliographic_citation": "dcterms:bibliographicCitation",
		"grant_number": "frapo:hasGrantNumber",
		"see_also": {"@id": "rdfs:seeAlso", "@type": "@id"},
		"entity": "serka:entity",
		"score": {"@id": "serka:score", "@type": "xsd:double"},
		"matched_on": "serka:matchedOn",
		"excerpt": "serka:excerpt",
		"path": {"@id": "serka:path", "@container": "@list"},
		"predicate": {"@id": "serka:predicate", "@type": "@vocab"},
		"source": {"@id": "serka:source", "@type": "@id"},
		"target": "serka:target",
		"agent": {"@reverse": "pro:holdsRoleInTime"},
		"role": {"@id": "pro:withRole", "@type": "@vocab"},
		"role_type": {"@id": "serka:roleType", "@type": "@vocab"},
		"relates_to": {"@id": "pro:relatesToEntity", "@type": "@id"},
		"meta": {"@id": "serka:meta", "@type": "@json"}
	},
	"node_types": {
		"Dataset": "dcat:Dataset",
		"Person": "foaf:Person",
		"Organisation": "foaf:Organization",
		"FundingAgency": "frapo:FundingAgency",
		"Grant": "frapo:Grant",
		"Concept": "skos:Concept",
		"Document": "fabio:Expression",
		"DigitalManifestation": "fabio:DigitalManifestation"
	},
	"relation_types": {
		"HAS_THEME": "dcat:theme",
		"AFFILIATED_WITH": "org:memberOf",
		"BROADER": "skos:broader"
	},
	"default_predicate": "dcterms:relation",
	"predicates": [
		"dcat:theme",
		"org:memberOf",
		"skos:broader",
		"dcterms:isPartOf",
		"dcterms:relation",
		"dcterms:references",
		"dcterms:isReferencedBy",
		"doo:originatingGrant",
		"frapo:awards"
	],
	"roles": {
		"author": "pro:author",
		"coAuthor": "pro:author",
		"editor": "pro:editor",
		"contributor": "pro:contributor",
		"publisher": "pro:publisher",
		"distributor": "pro:distributor",
		"originator": "scoro:data-creator",
		"custodian": "scoro:data-curator",
		"resourceProvider": "scoro:access-provider",
		"user": "scoro:data-user",
		"pointOfContact": "scoro:contact-person",
		"rightsHolder": "scoro:rights-holder",
		"stakeholder": "scoro:stakeholder",
		"principalInvestigator": "scoro:principal-investigator",
		"collaborator": "scoro:collaborator",
		"owner": "scoro:owner",
		"sponsor": "scoro:sponsor",
		"funder": "scoro:funder"
	},
	"default_role": "pro:contributor",
	"role_classes": {
		"pro:author": "pro:PublishingRole",
		"pro:editor": "pro:PublishingRole",
		"pro:contributor": "pro:PublishingRole",
		"pro:publisher": "pro:PublishingRole",
		"pro:distributor": "pro:PublishingRole",
		"scoro:data-creator": "scoro:DataRole",
		"scoro:data-curator": "scoro:DataRole",
		"scoro:access-provider": "scoro:DataRole",
		"scoro:data-user": "scoro:DataRole",
		"scoro:contact-person": "scoro:OrganizationalRole",
		"scoro:rights-holder": "scoro:OrganizationalRole",
		"scoro:stakeholder": "scoro:OrganizationalRole",
		"scoro:principal-investigator": "scoro:InvestigationRole",
		"scoro:collaborator": "scoro:InvestigationRole",
		"scoro:owner": "scoro:FinancialRole",
		"scoro:sponsor": "scoro:FinancialRole",
		"scoro:funder": "scoro:FinancialRole"
	},
	"not_in_doo": [
		"fabio:DigitalManifestation",
		"skos:broader",
		"dcat:theme",
		"dcterms:isPartOf",
		"dcterms:relation",
		"dcterms:references",
		"dcterms:isReferencedBy"
	],
	"definitions": {
		"dcat:Dataset": "A collection of data, published or curated by a single agent (here: an EIDC catalogue record).",
		"foaf:Person": "A person, identified by ORCID.",
		"foaf:Organization": "An organisation, identified by ROR.",
		"frapo:FundingAgency": "An organisation that funds research by awarding grants.",
		"frapo:Grant": "A sum of money awarded by a funding agency for a piece of research; identified by funder + award number.",
		"skos:Concept": "A keyword or theme from a controlled vocabulary (GEMET, INSPIRE topic categories, NERC/CEH topics, GeoNames, ...).",
		"fabio:Expression": "A citable published work, e.g. a paper that cites a dataset.",
		"fabio:DigitalManifestation": "A supporting file attached to a dataset (e.g. a PDF of methods); its text is available via get_content.",
		"pro:RoleInTime": "A role an agent holds with respect to a dataset (DOO's reified role pattern).",
		"dcat:theme": "Dataset -> Concept: a theme or keyword of the dataset.",
		"org:memberOf": "Person -> Organisation: affiliation.",
		"skos:broader": "Concept -> Concept: the target is a more general concept.",
		"dcterms:isPartOf": "Dataset -> Dataset: the subject is part of the target (e.g. a collection).",
		"dcterms:relation": "Dataset -> Dataset: a related dataset.",
		"dcterms:references": "Dataset -> DigitalManifestation: a supporting document of the dataset.",
		"dcterms:isReferencedBy": "Dataset -> Expression: a publication that cites the dataset.",
		"doo:originatingGrant": "Dataset -> Grant: the grant that funded the work producing the dataset.",
		"frapo:awards": "FundingAgency -> Grant: the funder awarded the grant.",
		"pro:PublishingRole": "Roles in producing or publishing the resource (author, publisher, distributor, ...).",
		"scoro:DataRole": "Roles in creating, curating or providing access to data.",
		"scoro:OrganizationalRole": "Organisational roles such as contact person or rights holder.",
		"scoro:InvestigationRole": "Research roles such as principal investigator or collaborator.",
		"scoro:FinancialRole": "Financial roles such as funder, sponsor or owner."
	}
}
