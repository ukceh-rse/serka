API_UPSTREAM=http://serka:8000

# Redis holds the search index and the answer cache.
REDIS_URL=redis://localhost:6379
# Local directory for the OKF bundle that ingest writes and the loader reads.
OKF_BUNDLE_DIR=./bundle

AWS_DEFAULT_REGION=eu-west-2
MODELS_EMBEDDING=amazon.titan-embed-text-v2:0

# Chat pipeline: Bedrock region used for every stage model below.
AWS_REGION=eu-west-2
# Classify: scope check (in/out of scope) and keyword/insight label.
MODELS_CLASSIFY=amazon.nova-lite-v1:0
# Plan (keyword): derives search parameters for a keyword query.
MODELS_PLAN_KEYWORD=amazon.nova-micro-v1:0
# Plan (insight): writes the retrieval plan for an insight query.
MODELS_PLAN_INSIGHT=eu.anthropic.claude-sonnet-5-5
# Execute (insight): chooses and calls catalogue (MCP) tools to carry out the plan.
MODELS_EXECUTE_INSIGHT=eu.anthropic.claude-haiku-5-5
# Synthesize (keyword): writes the answer for a keyword query.
MODELS_SYNTHESIZE_KEYWORD=amazon.nova-lite-v1:0
# Synthesize (insight): writes the answer for an insight query.
MODELS_SYNTHESIZE_INSIGHT=eu.anthropic.claude-sonnet-5-5
# Evaluate: checks each answer against the query (keep different from Synthesize).
MODELS_EVALUATE=eu.anthropic.claude-haiku-5-5

# Usage limits: model-backed runs allowed per UTC day, per client and overall, and insight runs overall.
# Counted in memory, so a restart resets them.
USAGE_IP_DAILY_LIMIT=30
USAGE_GLOBAL_DAILY_LIMIT=500
USAGE_INSIGHT_DAILY_LIMIT=100
# Rightmost X-Forwarded-For entries to skip to reach the client: the proxies that append to the header,
# minus one, because the outermost proxy's entry is the client's address. 0 ignores the header.
# Too high a value lets clients choose their identity. With only one appending proxy, leave this at 0.
# Behind proxies, set this to match the chain, or all users share one allowance.
TRUSTED_PROXY_HOPS=0
# Enables /v1/chat/stream/agui. Limits on chat history are required before using this in production.
CHAT_ENABLED=false

# Answer cache: accepted first-turn AI Summary answers reused for near-identical queries.
# Off in test mode. The threshold is a cosine distance; lower is stricter.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_DISTANCE_THRESHOLD=0.05
ANSWER_CACHE_TTL_SECONDS=604800

# Legilo personal access token (sent as a bearer token)
LEGILO_PAT=

# REDIS_DATA_DIR=/opt/serka/redis
# FEEDBACK_DATA_DIR=/opt/serka/feedback
