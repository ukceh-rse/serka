API_UPSTREAM=http://serka:8000

NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

AWS_DEFAULT_REGION=eu-west-2
MODELS_EMBEDDING=amazon.titan-embed-text-v2:0

# Chat pipeline: Bedrock region used for every stage model below.
AWS_REGION=eu-west-2
# Classify: scope check (in/out of scope) and keyword/insight label.
MODELS_CLASSIFY=amazon.nova-lite-v1:0
# Plan (keyword): derives search parameters for a keyword query.
MODELS_PLAN_KEYWORD=amazon.nova-micro-v1:0
# Plan (insight): writes the retrieval plan for an insight query.
MODELS_PLAN_INSIGHT=eu.anthropic.claude-sonnet-5-5
# Execute (insight): chooses and calls catalogue (MCP) tools to carry out the plan.
MODELS_EXECUTE_INSIGHT=eu.anthropic.claude-haiku-5-5
# Synthesize (keyword): writes the answer for a keyword query.
MODELS_SYNTHESIZE_KEYWORD=amazon.nova-lite-v1:0
# Synthesize (insight): writes the answer for an insight query.
MODELS_SYNTHESIZE_INSIGHT=eu.anthropic.claude-sonnet-5-5
# Evaluate: checks each answer against the query (keep different from Synthesize).
MODELS_EVALUATE=eu.anthropic.claude-haiku-5-5

LEGILO_USERNAME=
LEGILO_PASSWORD=

# NEO4J_DATA_DIR=/opt/serka/neo4j
# FEEDBACK_DATA_DIR=/opt/serka/feedback
